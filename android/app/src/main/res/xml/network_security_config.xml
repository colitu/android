<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        ISRG Root X1 ships with the app as well: Android 7.0 (API 24) has no
        Let's Encrypt root in its system store (X1 arrived in 7.1.1), and the
        colitu.com chain ends at ISRG Root X2 signed by X1. Same root as the
        X1 pin below (ColituCertPinsTest checks the file against PINS).
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>

    <!--
        colitu.com and api.colitu.com must chain to one of these root keys
        (SHA-256 of the SubjectPublicKeyInfo). Let's Encrypt issues the
        certificates today (Root YE / X2 / X1); Root YR and Google Trust
        Services are backups in case the edge or the CA changes.
        The pins stop working on the expiration date on purpose, so an app
        that was never updated falls back to normal system trust instead of
        losing the API. Renew the date (and the list) with every release.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">colitu.com</domain>
        <!-- Same roots and end date as ColituCertPins (PINS, EXPIRES): change both together. -->
        <pin-set expiration="2027-12-31">
            <!-- ISRG Root X1 -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <!-- ISRG Root X2 -->
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
            <!-- ISRG Root YE -->
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
            <!-- ISRG Root YR -->
            <pin digest="SHA-256">fk6IOKit1ild5647BH06ujSIq5XbCgqlbYl6ANhhi88=</pin>
            <!-- GTS Root R1 (backup) -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <!-- GTS Root R4 (backup) -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </domain-config>

    <!--
        Plain-HTTP connectivity probes of the traffic check (CoreServiceManager:
        the warm spare's health check and one of the connect checks). They go
        through the local check proxy into the tunnel and only read a 204/200,
        no data. Exact hosts, no subdomains; everything else stays HTTPS-only.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">www.gstatic.com</domain>
        <domain includeSubdomains="false">www.msftconnecttest.com</domain>
    </domain-config>
</network-security-config>
