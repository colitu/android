<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Night theme: inherit the shared AppThemeBase and override night-specific items -->
    <style name="AppThemeDayNight" parent="AppThemeBase">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:statusBarColor">@color/colitu_bg</item>
        <item name="android:navigationBarColor">@color/colitu_nav_bg</item>
        <item name="android:windowBackground">@color/colitu_bg</item>
        <item name="android:textColorPrimary">@color/colitu_text_primary</item>
        <item name="android:textColorSecondary">@color/colitu_text_secondary</item>
    </style>

    <!-- Colitu full-dark theme for Colitu screens -->
    <style name="ColituTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/colitu_blue</item>
        <item name="colorOnPrimary">@color/colitu_text_primary</item>
        <item name="colorPrimaryContainer">@color/colitu_blue_overlay</item>
        <item name="colorSecondary">@color/colitu_cyan</item>
        <item name="colorTertiary">@color/colitu_success</item>
        <item name="colorError">@color/colitu_danger</item>
        <item name="colorSurface">@color/colitu_surface</item>
        <item name="colorOnSurface">@color/colitu_text_primary</item>
        <item name="colorSurfaceVariant">@color/colitu_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/colitu_text_secondary</item>
        <item name="colorOutline">@color/colitu_border</item>
        <item name="android:colorBackground">@color/colitu_bg</item>
        <item name="android:windowBackground">@color/colitu_bg</item>
        <item name="android:statusBarColor">@color/colitu_bg</item>
        <item name="android:navigationBarColor">@color/colitu_nav_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
