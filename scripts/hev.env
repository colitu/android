# libhev-socks5-tunnel.so in android/app/libs/<abi>/ is built from this commit
# of hev-socks5-tunnel (tag 2.15.0) with exactly this NDK release by
# compile-hevtun.sh, which compares the result with android/app/libs/SHA256SUMS.
# The NDK is part of the pin: the shipped files carry its .note.android.ident
# (r27c, 12479018) and another release compiles different bytes.
HEV_REPO=https://github.com/heiher/hev-socks5-tunnel
HEV_COMMIT=00c7eb9ad7ca381b0f1fee880abc1077fe9b93be
HEV_NDK=27.2.12479018
