# colitu-engine (libcolituengine.so) and csl-client (libcslclient.so) in
# android/app/libs/<abi>/ are built from this commit of the public colitu/csl
# repository by its own build scripts (engine/build.sh, cmd/csl-client/build.sh)
# with exactly this Go toolchain. scripts/build-sidecars.sh rebuilds them and
# compares with android/app/libs/SHA256SUMS; CI runs it on every push.
CSL_REPO=https://github.com/colitu/csl
CSL_COMMIT=6da38f5c302730f799969a58b2bbdc49d72b6b69
CSL_GO=go1.27.1
