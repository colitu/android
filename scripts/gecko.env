# ColituGecko: gecko-client (libgeckoclient.so) is built by
# scripts/build-gecko.sh from this commit of Colitu's PRIVATE repository
# colituvpn/colitu-gecko (not open source; cloning it needs access) with
# exactly this Go toolchain. The binaries are never committed: *.so is ignored
# and, unlike the colitu/csl sidecars, they are not force-added, because this
# repository is public. An APK built without them has no gecko-client and the
# app reports "gecko-client missing" (the ColituGecko protocol cannot connect, nothing else changes).
GECKO_REPO=https://github.com/colituvpn/colitu-gecko
GECKO_COMMIT=e9b1e717939a3a7d1d67d394da8884869e7967bf
GECKO_GO=go1.27.1
